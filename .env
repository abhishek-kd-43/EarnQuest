# Database URL (SQLite for local zero-dependency execution, Postgres supported)
DATABASE_URL="file:./dev.db"

# Session Secret (random 32+ char string in production)
SESSION_SECRET="earnquest-super-secret-cryptographic-signing-key-32chars"

# Optional Live Provider API Keys (leave blank to use high-fidelity Mock providers)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
BRAVE_SEARCH_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_IGNORE_INCORRECT_LOCKFILE="1"
